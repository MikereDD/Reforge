{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typezero.local/reforge/catalog.schema.json",
  "title": "Reforge Installer Catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "menuOrder",
        "architecture",
        "channel",
        "sourcePolicy",
        "bootMethod",
        "onlineRequired",
        "recommended"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["os", "rescue", "diagnostic"]
        },
        "menuOrder": { "type": "integer", "minimum": 1 },
        "architecture": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["x86_64", "aarch64"]
          }
        },
        "channel": { "type": "string", "minLength": 1 },
        "sourcePolicy": {
          "type": "string",
          "enum": ["official-only", "official-preferred", "reforge-hosted"]
        },
        "bootMethod": {
          "type": "string",
          "enum": ["netboot", "wim", "iso", "uki", "custom"]
        },
        "onlineRequired": { "type": "boolean" },
        "recommended": { "type": "boolean" },
        "resolver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["static", "remote-manifest", "upstream-latest"]
            },
            "url": { "type": "string", "format": "uri" }
          },
          "required": ["type"]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "boolean" },
            "methods": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["sha256", "sha512", "gpg", "authenticode"]
              }
            }
          },
          "required": ["required", "methods"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
