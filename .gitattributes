* text=auto
.gitattributes text eol=lf

# Linux / cross-platform text
*.sh      text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf

# Windows scripts
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.psd1    text eol=crlf

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.zip     binary
*.iso     binary
*.img     binary
